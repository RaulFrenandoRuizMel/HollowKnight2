  letreroHablar: {fileID: 35594784}
  dialogos:
  - "Ja, ja, ja. \xBFConoces esa? \xA1Es una de mis favoritas! Podemos cantar otra
    cosa, si prefieres. Empieza a cantar y te sigo. \xA1Seguro que tienes una voz
    pre... preciosa! \xA1Ja, ja, ja!"
  - "\xBFQu\xE9 haces aqu\xED abajo, por cierto? \xA1Si has venido en busca de riquezas,
    mira a tu alrededor! \xA1Estas minas est\xE1n repletas de riquezas! \xA1Hay mucho
    para todos! \xA1Coge un pico y \xFAnete! \xA1Ja, ja! "
  - "\xA1Ohh, entierra al caballero con su aguij\xF3n roto,  entierra al... sa...
    sacerdote... \xBFiba algo de una corona? "
  - "No pu... puedo acordarme de c\xF3mo segu\xEDa ese. \xA1Ja, ja, ja! Igual mejor
    voy a tararear. "
  nombre: Myla2
  OnDialogoTerminado:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 47586794}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
